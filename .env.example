OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=replace-with-your-model-name
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
DATABASE_URL=postgresql+asyncpg://newagent:newagent@127.0.0.1:5434/newagent
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
QDRANT_COLLECTION=conversation_memories_v1
QDRANT_DOCUMENT_COLLECTION=document_chunks_v1
# System default for uploads whose graph mode is "inherit".
# Users can still skip graph extraction per document from the knowledge-base UI.
NEO4J_ENABLED=true
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=newagent-graph
GRAPH_MAX_FACTS_PER_CHUNK=20
GRAPH_INDEX_CONCURRENCY=4
DOCUMENT_STORAGE_PATH=backend/data/documents
DOCUMENT_MAX_UPLOAD_MB=25
AVATAR_STORAGE_PATH=backend/data/avatars
AVATAR_MAX_UPLOAD_MB=5
MEDIA_STORAGE_PATH=backend/data/media
MEDIA_MAX_RESPONSE_MB=15
MEDIA_REQUEST_TIMEOUT_SECONDS=60
MEDIA_WORKER_POLL_SECONDS=1.0
MEDIA_WORKER_MAX_ATTEMPTS=3
MEDIA_MAX_TASKS_PER_MESSAGE=2

# Optional NPC runtime. Enable each stage independently after applying migrations.
SINGLE_NPC_ENABLED=false
GROUP_NPC_ENABLED=false
MEMORY_COMPRESSION_ENABLED=false
CHAT_REQUESTS_PER_MINUTE=30
SERVER_MAX_SPEAKERS_PER_TURN=4
SERVER_MAX_GROUP_GENERATIONS=6
SUMMARY_TRIGGER_MESSAGES=40
SUMMARY_KEEP_RECENT=20
SUMMARY_WORKER_POLL_SECONDS=2.0
SUMMARY_WORKER_MAX_ATTEMPTS=5

# Optional administrator-managed media providers. Secrets are never returned by capability APIs.
IMAGE_GENERATION_ENABLED=false
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=gpt-image-1
IMAGE_PROFILES=default
TTS_ENABLED=false
TTS_PROVIDER_BASE_URL=
TTS_PROVIDER_API_KEY=
TTS_PROVIDER_MODEL=tts-1
TTS_PROFILES=alloy
DOCUMENT_CHUNK_CHARACTERS=1200
DOCUMENT_CHUNK_OVERLAP_CHARACTERS=200
DOCUMENT_CONTEXT_WINDOW=1
DOCUMENT_WORKER_POLL_SECONDS=1.0
DOCUMENT_WORKER_MAX_ATTEMPTS=5
DOCUMENT_RESULT_LIMIT=6
DOCUMENT_RELEVANCE_THRESHOLD=0.45
SESSION_COOKIE_NAME=newagent_session
CSRF_COOKIE_NAME=newagent_csrf
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
NETWORK_TOOLS_ENABLED=true
SKILLS_PATH=../skills

# DeepEval end-to-end RAG evaluation (use a dedicated local test account)
EVAL_BASE_URL=http://127.0.0.1:8021
EVAL_USERNAME=replace-with-eval-username
EVAL_PASSWORD=replace-with-eval-password
EVAL_CASE_LIMIT=5
EVAL_REQUEST_TIMEOUT_SECONDS=180
EVAL_KEEP_CONVERSATIONS=false
# Optional judge overrides; defaults to OPENAI_* when omitted
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
